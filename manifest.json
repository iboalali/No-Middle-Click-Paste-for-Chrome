{
  "manifest_version": 3,
  "name": "No Middle-Click Paste",
  "version": "1.0.0",
  "description": "Disables middle-click (primary selection) paste in editable fields. Keeps middle-click open-in-new-tab.",
  "author": "Ibrahim Al-Alali",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "No Middle-Click Paste",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": ["content.js"]
    }
  ]
}
